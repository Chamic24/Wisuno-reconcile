# 数据库
DATABASE_URL=postgresql://recon:recon@localhost:5432/recon

# 每家 PSP 的密钥只放环境变量 / 密钥管理（AWS Secrets Manager、Vault 等），不要写进代码或数据库
# PSP_ENV=sandbox|production（每家可单独覆盖，如 LIPAD_ENV=production）
PSP_ENV=sandbox

# Lipad（东非：KES / TZS / UGX）
LIPAD_CONSUMER_KEY=
LIPAD_CONSUMER_SECRET=

# Paystack（尼日利亚）
PAYSTACK_SECRET_KEY=

# Pay247 —— 文档未能从开发环境访问，字段待补
PAY247_MERCHANT_ID=
PAY247_API_KEY=
PAY247_BASE_URL=

# LetKnow Pay（加密货币）—— 文档未能从开发环境访问，字段待补
LETKNOW_API_KEY=
LETKNOW_API_SECRET=
LETKNOW_BASE_URL=
